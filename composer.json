{
  "name": "dibify/storage-mongodb",
  "type": "library",
  "description": "DiBify MongoDB storage",
  "keywords": [
    "db",
    "database",
    "orm",
    "mongodb"
  ],
  "authors": [
    {
      "name": "Timur Kasumov aka XAKEPEHOK",
      "role": "Main developer"
    }
  ],
  "license": "BSD-3-Clause",
  "require": {
    "php": "^8.2",
    "ext-mongodb": "^2.1",
    "ext-mbstring": "*",
    "dibify/dibify": "^0.11.0",
    "mongodb/mongodb": "^2.1",
    "xakepehok/array-wildcard-explainer": "^0.1.0",
    "adbario/php-dot-notation": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {"DiBify\\Storage\\MongoDB\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"DiBify\\Storage\\MongoDB\\Tests\\": "tests/"}
  }
